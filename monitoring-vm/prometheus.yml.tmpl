global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "alert.rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 'alertmanager:9093'

scrape_configs:
  # ── Kafka 브로커 메트릭 ────────────────────────
  - job_name: 'kafka'
    static_configs:
      - targets:
          - '${KAFKA_1_HOST}:9308'
          - '${KAFKA_2_HOST}:9308'
          - '${KAFKA_3_HOST}:9308'
        labels:
          cluster: 'goggle-kafka'

  # ── Redis 메트릭 ───────────────────────────────
  - job_name: 'redis'
    static_configs:
      - targets:
          - '${REDIS_1_HOST}:9121'
          - '${REDIS_2_HOST}:9121'
          - '${REDIS_3_HOST}:9121'
        labels:
          cluster: 'goggle-redis'

  # ── 각 VM 시스템 메트릭 (Node Exporter) ────────
  - job_name: 'node-kafka'
    static_configs:
      - targets:
          - '${KAFKA_1_HOST}:9100'
          - '${KAFKA_2_HOST}:9100'
          - '${KAFKA_3_HOST}:9100'
        labels:
          group: 'kafka'

  - job_name: 'node-redis'
    static_configs:
      - targets:
          - '${REDIS_1_HOST}:9100'
          - '${REDIS_2_HOST}:9100'
          - '${REDIS_3_HOST}:9100'
        labels:
          group: 'redis'

  # ── 서비스 메트릭 ──────────────────────────────
  - job_name: 'mentoring-service'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets:
          - '${MENTORING_SERVICE_HOST}:9006'
        labels:
          service: 'mentoring-service'

  - job_name: 'order-service'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets:
          - '${ORDER_SERVICE_HOST}:9007'
        labels:
          service: 'order-service'

  - job_name: 'lecture-service'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets:
          - '${LECTURE_SERVICE_HOST}:9005'
        labels:
          service: 'lecture-service'

  - job_name: 'payment-service'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets:
          - '${PAYMENT_SERVICE_HOST}:9008'
        labels:
          service: 'payment-service'

  - job_name: 'user-service'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets:
          - '${USER_SERVICE_HOST}:9010'
        labels:
          service: 'user-service'

  # ── Prometheus 자체 메트릭 ─────────────────────
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']